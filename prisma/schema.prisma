datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dispatcher {
  id        String   @id @default(uuid())
  name      String
  phone     String
  status    String   @default("Available") // Available, On-Call, Off-Duty
  shift     String   @default("Morning")   // Morning, Evening, Night
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts    OnCallShift[]
  logs      CallLog[]
}

model OnCallShift {
  id           String     @id @default(uuid())
  dispatcherId String
  dispatcher   Dispatcher @relation(fields: [dispatcherId], references: [id])
  startDate    DateTime
  endDate      DateTime
  notes        String?
  createdAt    DateTime   @default(now())
}

model CallLog {
  id           String      @id @default(uuid())
  dispatcherId String?
  dispatcher   Dispatcher? @relation(fields: [dispatcherId], references: [id])
  callerName   String
  callerPhone  String
  issue        String
  status       String      @default("Open") // Open, Resolved, Escalated
  createdAt    DateTime    @default(now())
}
